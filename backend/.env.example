# Backend environment variables. Copy to backend/.env (gitignored).
# dotenv loads .env from the process working directory, which is backend/
# when started via `npm run dev` / `make dev` from the repo root.
# All variables are optional; defaults are shown.

# HTTP + WebSocket port.
PORT=4000

# Directory of source YAML definitions. Default: <repo>/sources.d
# SOURCES_DIR=../sources.d

# SQLite database file, relative to the working directory (backend/).
DB_PATH=mk-osint.db

# Database size ceiling in MB. Above it the retention job prunes the oldest observations
# (down to 90%) and runs an incremental vacuum. 0 disables the guard.
MKOSINT_DB_MAX_MB=500

# Set to "false" to load sources without polling them. Any other value (or unset) enables ingestion.
INGEST_ENABLED=true

# --- Web client / deployment (see docs/development.md#deployment) ---
# Serve frontend/dist from this process: true | false | unset (auto: on when NODE_ENV=production).
# MKOSINT_SERVE_FRONTEND=
# MKOSINT_FRONTEND_DIR=../frontend/dist

# Client-safe settings served at GET /config.json. These ARE visible to the browser.
# MKOSINT_APP_NAME=MK-OSINT
# MKOSINT_CESIUM_ION_TOKEN=
# MKOSINT_DEFAULT_GLOBE_STYLE=tactical

# ---------------------------------------------------------------------------
# Source secrets (API keys, tokens, passwords)
#
# Source YAML never contains secrets. Instead it references environment variables with
# placeholders, which the engine resolves from process.env at request time:
#
#   ${NAME}             value of NAME; the source is skipped at load if NAME is unset/empty
#   ${NAME:-default}    value of NAME, or "default" when NAME is unset/empty
#
# Placeholders are honoured in transport.url, transport.headers values, transport.body,
# transport.auth fields and transport.subscribe (websocket). Example:
#
#   transport:
#     url: https://api.example.com/v1/items?key=${EXAMPLE_API_KEY}
#     auth: { type: bearer, token: ${EXAMPLE_TOKEN} }
#
# A source that references an unset variable is logged as
#   "source <name> disabled: missing env <NAME>"
# and is not registered or polled, so keyed sources ship inert until their key is set here.
# Resolved values are never written to the database or API responses and are masked (***)
# in log and error messages.
#
# Keys used by the bundled sources are listed below.
# ---------------------------------------------------------------------------
# --- AI analysis (analysis.d/) ---------------------------------------------------------
# Off unless a provider is configured. Default provider: anthropic (model claude-sonnet-5).
# MKOSINT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MKOSINT_ANTHROPIC_BASE_URL=https://api.anthropic.com
# OpenAI or any OpenAI-compatible server (Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1):
# MKOSINT_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# MKOSINT_OPENAI_BASE_URL=https://api.openai.com/v1
# MKOSINT_OPENAI_RESPONSE_FORMAT=json_schema   # json_object for servers without JSON-schema output
# MKOSINT_LLM_MODEL=
# MKOSINT_LLM_TIMEOUT_MS=120000
# MKOSINT_ANALYSIS_DIR=../analysis.d
