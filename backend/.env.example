# Backend environment variables. Copy to backend/.env (gitignored).
# dotenv loads .env from the process working directory, which is backend/
# when started via `npm run dev` / `make dev` from the repo root.
# All variables are optional; defaults are shown.

# HTTP + WebSocket port.
PORT=4000

# Directory of source YAML definitions. Default: <repo>/sources.d
# SOURCES_DIR=../sources.d

# SQLite database file, relative to the working directory (backend/).
DB_PATH=mk-osint.db

# Set to "false" to load sources without polling them. Any other value (or unset) enables ingestion.
INGEST_ENABLED=true

# --- AI analysis (analysis.d/) ---------------------------------------------------------
# Off unless a provider is configured. Default provider: anthropic (model claude-sonnet-5).
# MKOSINT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MKOSINT_ANTHROPIC_BASE_URL=https://api.anthropic.com
# OpenAI or any OpenAI-compatible server (Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1):
# MKOSINT_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# MKOSINT_OPENAI_BASE_URL=https://api.openai.com/v1
# MKOSINT_OPENAI_RESPONSE_FORMAT=json_schema   # json_object for servers without JSON-schema output
# MKOSINT_LLM_MODEL=
# MKOSINT_LLM_TIMEOUT_MS=120000
# MKOSINT_ANALYSIS_DIR=../analysis.d
